# Скопируйте в .env и подставьте свои значения: cp .env.example .env

# База данных
POSTGRES_DB=oksei
POSTGRES_USER=oksei
POSTGRES_PASSWORD=смените_этот_пароль

# Подпись сессионных токенов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=смените_на_случайную_строку_минимум_16_символов

# Срок жизни сессии
TOKEN_TTL=720h

# true — если сайт открывается по https (cookie будет отдаваться только по TLS)
COOKIE_SECURE=false

# false — самостоятельная регистрация закрыта, учётки создаёт только админ
ALLOW_REGISTRATION=true

# Стартовый администратор. Создаётся только если в базе ещё нет админов.
ADMIN_EMAIL=admin@oksei.local
ADMIN_PASSWORD=смените_этот_пароль

# Внешний порт веб-сервера
HTTP_PORT=80
